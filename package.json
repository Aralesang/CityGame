{
  "name": "autonomous-town-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "npm run build --silent && node dist/src/cli.js",
